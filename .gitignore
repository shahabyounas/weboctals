# Dependencies
node_modules/
package-lock.json

# Build output (generated by Parcel)
# dist/ is intentionally TRACKED: cPanel (Namecheap) Git Version Control deploys
# it verbatim via .cpanel.yml, and that server has no Node toolchain to build
# with. Amplify and GitHub Pages still build from source and ignore the commit.
# Run `npm run build:all` and commit dist/ before deploying to cPanel.
.parcel-cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

